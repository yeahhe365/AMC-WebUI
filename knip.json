{
  "workspaces": {
    ".": {
      "entry": [
        "src/utils/export/dom.ts",
        "src/utils/export/files.ts",
        "src/utils/export/image.ts",
        "src/utils/export/templates.ts"
      ]
    },
    "server": {
      "entry": ["src/index.ts", "../shared/connectionSafeFetch.ts"],
      "project": ["src/**/*.ts", "../shared/**/*.ts"],
      "ignoreDependencies": ["undici"]
    }
  },
  "ignore": ["docker/web-server.js", "public/runtime-config.js", "e2e/fixtures/mcp-test-server.mjs"],
  "ignoreDependencies": ["pyodide", "lamejs", "@iconify-json/material-icon-theme", "cookie"],
  "ignoreBinaries": ["wrangler"],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "rules": {
    "duplicates": "off"
  },
  "ignoreIssues": {}
}
