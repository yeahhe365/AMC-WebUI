# API container
# Get your Gemini key at https://aistudio.google.com/apikey
# Optional. Leave empty for pure BYOK; set only for server-managed regular Gemini requests.
GEMINI_API_KEY=
# Optional dedicated server-managed key for Live API (falls back to GEMINI_API_KEY if unset)
LIVE_GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com
# Server-selected Gemini keys always use this trusted administrator target.
# Browser base URL overrides apply only when a browser BYOK key is selected.
# Optional, comma-separated. Leave empty for same-origin Docker usage.
ALLOWED_ORIGINS=
# API server port (defaults to 3001).
PORT=3001
# MCP transports are disabled by default on the API container.
# Enable only for trusted self-hosted deployments.
ENABLE_MCP_STDIO=false
ENABLE_MCP_PRIVATE_HTTP=false
# Allow third-party proxy to forward to local/private HTTP endpoints (e.g. Ollama, LM Studio, vLLM
# at http://localhost:11434 or http://host.docker.internal:11434). Default false (SSRF protection).
ENABLE_THIRD_PARTY_PRIVATE_HTTP=false

# Live API WebSocket proxy (Docker only). When true, the api container
# terminates the WS upgrade on /api/live and bridges it to wss://generativelanguage…/BidiGenerateContent.
ENABLE_LIVE_WS_PROXY=true
LIVE_WS_IDLE_TIMEOUT_MS=300000
# Key priority for all three chains (gemini / live / third-party):
#   false (default) → browser BYOK key wins, server key is the fallback (BYOK 兜底)
#   true            → server key wins, browser key is the fallback
SERVER_KEY_PRIORITY=false
# JSON object: provider id → { baseUrl, apiKey }. Only https + non-private hosts.
# THIRD_PARTY_ROUTES={"openai":{"baseUrl":"https://api.openai.com/v1","apiKey":"sk-…"},"deepseek":{"baseUrl":"https://api.deepseek.com","apiKey":"…"}}
THIRD_PARTY_ROUTES=
# Server API access password gatekeeper (optional).
# When set, requires all client requests to /api/* to provide this password.
ACCESS_PASSWORD=
# Alias for ACCESS_PASSWORD:
SERVER_ACCESS_TOKEN=

# Stream journal budgets (positive integers; bytes or milliseconds as named).
# Full defaults and correlated limits: docs/optimization-2026-10-23.md
AMC_STREAM_JOB_MAX_ACTIVE=32
AMC_STREAM_JOB_MAX_JOBS=256
AMC_STREAM_JOB_IDLE_MS=120000
AMC_STREAM_JOB_HARD_MS=3600000
AMC_STREAM_JOB_EVENT_BYTES=8388608
AMC_STREAM_JOB_RETAINED_BYTES=8388608
AMC_STREAM_JOB_TOTAL_RETAINED_BYTES=67108864

# Web container
WEB_PORT=8080

# Frontend runtime-config.js values injected at container startup.
# These are Docker-only: when absent (static/Pages deploy) the frontend falls
# back to direct browser connections and nothing changes.
RUNTIME_SERVER_MANAGED_API=true
# NOT published to the browser. runtime-config.js only reports whether a
# password is required; the container uses the value for the WS handshake.
# Users enter ACCESS_PASSWORD once in their browser.
RUNTIME_SERVER_ACCESS_PASSWORD=
RUNTIME_USE_CUSTOM_API_CONFIG=true
RUNTIME_USE_API_PROXY=true
RUNTIME_API_PROXY_URL=/api/gemini
RUNTIME_LIVE_API_BASE_URL=/api/live
RUNTIME_THIRD_PARTY_PROXY_URL=/api/openai
RUNTIME_PYODIDE_BASE_URL=
# Optional build-time flag: PYODIDE_ASSETS_EXTERNAL=true pnpm run build
# Requires a matching versioned RUNTIME_PYODIDE_BASE_URL at runtime.

# Docker build args (optional, defaults to official registry)
# For users in mainland China, you can set: NPM_REGISTRY=https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
