# Atlas Cloud (OpenAI-compatible) — alternative/supplement to Gemini
# Get your API key at https://www.atlascloud.ai/console/coding-plan
# In AMC-WebUI settings, switch to "OpenAI Compatible" mode and fill in:
#   Base URL : https://api.atlascloud.ai/v1
#   API Key  : <your-atlascloud-key>
#   Model    : deepseek-ai/deepseek-v4-pro  (or any of 59 supported models)
# Note: ensure max_tokens >= 512 to avoid empty responses.
# The following are frontend-only convenience presets (only for dev mode via .env.local):
# VITE_OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# VITE_OPENAI_API_KEY=<your-atlascloud-key>

# API container
# Get your Gemini key at https://aistudio.google.com/apikey
# Optional. Leave empty for BYOK usage; set only for server-managed regular Gemini requests.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com
# Optional, comma-separated. Leave empty for same-origin Docker usage.
ALLOWED_ORIGINS=
# MCP transports are disabled by default on the API container.
# Enable only for trusted self-hosted deployments.
ENABLE_MCP_STDIO=false
ENABLE_MCP_PRIVATE_HTTP=false

# Web container
WEB_PORT=8080

# Frontend runtime-config.js values injected at container startup
RUNTIME_SERVER_MANAGED_API=false
RUNTIME_USE_CUSTOM_API_CONFIG=true
RUNTIME_USE_API_PROXY=true
RUNTIME_API_PROXY_URL=/api/gemini
RUNTIME_PYODIDE_BASE_URL=
